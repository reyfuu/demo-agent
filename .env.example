# Salin file ini jadi .env lalu isi API key kamu
# Dapatkan gratis di: https://aistudio.google.com/apikey
GOOGLE_API_KEY=isi_api_key_gemini_disini

# Opsional
GEMINI_MODEL=gemini-3.7-flash

# Mode hemat kuota (default 1). Set 0 untuk demo penuh yang lebih boros.
#   HEMAT=1 -> LangChain 1 req, LangGraph 2 req, CrewAI 2 req  (~5 total)
#   HEMAT=0 -> LangChain 5 req, LangGraph 6 req, CrewAI 9 req  (~20 total)
HEMAT=1
